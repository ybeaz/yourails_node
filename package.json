{
  "name": "yourails_node",
  "version": "0.24.1",
  "author": "ybeaz",
  "private": false,
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "unpkg": "dist/lib.min.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./consoler": {
      "types": "./dist/SharedNode/consoler.d.ts",
      "default": "./dist/SharedNode/consoler.js"
    },
    "./consolerError": {
      "types": "./dist/SharedNode/consolerError.d.ts",
      "default": "./dist/SharedNode/consolerError.js"
    }
  },
  "scripts": {
    "cleanCache": "pnpm cache clean --force",
    "removeCreateDist": "rm -rf dist && mkdir dist",
    "buildUnpkg": "tsx esbuild.config.ts",
    "gzipUnpkg": ": gzip -k dist/lib.min.js",
    "build": "pnpm removeCreateDist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && pnpm buildUnpkg && pnpm gzipUnpkg",
    "pub": "pnpm build && pnpm publish --access public --quiet --registry=https://registry.npmjs.org/",
    "pubV2": "pnpm build && npm publish --access public --registry=https://registry.npmjs.org/",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dependenciesAudit": "npx knip --dependencies",
    "dependenciesFix": "npx knip --dependencies --fix --fix-type dependencies && pnpm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ybeaz/yourails_common.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/ybeaz/yourails_common/issues"
  },
  "homepage": "https://github.com/ybeaz/yourails_common#readme",
  "dependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@mozilla/readability": "^0.6.0",
    "@types/ejs": "^3.1.5",
    "@types/jsonwebtoken": "^9.0.7",
    "aws-jwt-verify": "^4.0.1",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "csv-parse": "^6.2.1",
    "csv-writer": "^1.6.0",
    "csvjson": "^5.1.0",
    "debug": "^4.4.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "esbuild-plugin-node-externals": "^1.0.1",
    "graphql": "^16.8.1",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.0",
    "nanoid": "^3.3.11",
    "ncp": "^2.0.0",
    "node-notifier": "^10.0.1",
    "open": "^11.0.1",
    "playwright": "^1.60.0",
    "proper-lockfile": "^4.1.2",
    "react": "^18.2.0",
    "sharp": "^0.34.5",
    "slice-ansi": "^9.0.1",
    "uuid": "^10.0.0",
    "yargs": "17.7.2",
    "yourails_common": "link:../yourails_common",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/debug": "^4.1.13",
    "@types/jest": "^29.5.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/node-notifier": "^8.0.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.0.38",
    "@types/uglify-js": "^3.17.4",
    "@types/uuid": "^9.0.7",
    "@types/yargs": "^17.0.35",
    "class-validator": "^0.15.1",
    "concurrently": "^10.0.7",
    "esbuild": "^0.25.12",
    "jest": "28.0.2",
    "less": "^4.1.3",
    "sass": "^1.62.0",
    "stylus": "^0.59.0",
    "ts-jest": "28.0.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "uglify-js": "^3.19.3"
  },
  "engines": {}
}
